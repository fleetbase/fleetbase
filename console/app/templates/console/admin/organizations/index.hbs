{{page-title (t "console.admin.organizations.index.title")}}

<Layout::Section::Header
    @title={{t "console.admin.organizations.index.title"}}
    @searchQuery={{this.query}}
    @onSearch={{this.search}}
    @searchPlaceholder="Search organizations, owners, email or phone"
    @searchInputClass="admin-organization-resource-search"
    @actionsWrapperClass="space-x-1"
>
    <Admin::Organizations::FiltersPicker
        @columns={{this.filterColumns}}
        @onApply={{fn this.filters.apply this}}
        @onClear={{this.clearFilters}}
        @onFilterClear={{this.filters.clear}}
        @onChange={{this.filters.set}}
        @iconOnly={{true}}
        @buttonWrapperClass="admin-organization-resource-action-button"
    />
    <VisibleColumnPicker @columns={{this.columns}} @onChange={{this.setColumns}} @iconOnly={{true}} class="admin-organization-resource-action-button" />
    {{#each this.actionButtons as |headerAction|}}
        {{#if headerAction.items}}
            <DropdownButton @text={{headerAction.text}} @icon={{headerAction.icon}} @type={{headerAction.type}} @size="sm" @renderInPlace={{true}} as |dd|>
                <div class="next-dd-menu mt-1 mx-0">
                    {{#each headerAction.items as |item|}}
                        {{#if item.separator}}
                            <div class="next-dd-menu-seperator"></div>
                        {{else}}
                            <button type="button" class="next-dd-item" {{on "click" (dropdown-fn dd item.onClick)}}>
                                <FaIcon @icon={{item.icon}} class="mr-2" />
                                <span>{{item.label}}</span>
                            </button>
                        {{/if}}
                    {{/each}}
                </div>
            </DropdownButton>
        {{else}}
            <Button
                @text={{if this.selectedOrganizations.length "Export selected" headerAction.text}}
                @icon={{headerAction.icon}}
                @iconClass={{headerAction.iconClass}}
                @onClick={{headerAction.onClick}}
                @size="sm"
            />
        {{/if}}
    {{/each}}
</Layout::Section::Header>

<Layout::Section::Body>
    <Table
        @rows={{@model}}
        @columns={{this.columns}}
        @pagination={{true}}
        @paginationMeta={{@model.meta}}
        @page={{this.page}}
        @onPageChange={{fn (mut this.page)}}
        @sortBy={{this.sort}}
        @onSort={{this.sortOrganizations}}
        @selectable={{true}}
        @canSelectAll={{true}}
        @checkboxSticky={{true}}
        @onRowClick={{this.goToCompany}}
        @searchQuery={{this.query}}
        @isFiltered={{this.isFiltered}}
        @emptyStateComponent={{component
            "table/empty-state"
            variant="compact"
            icon="building"
            title="No organizations found"
            description="Search by organization or owner details, or adjust your filters."
            filteredTitle="No organizations match your filters"
            filteredDescription="Adjust the search, filters, or saved view to find another organization."
            primaryText="Clear search and filters"
            primaryIcon="filter-circle-xmark"
            primaryAction=this.clearFilters
        }}
    />
</Layout::Section::Body>

{{outlet}}
