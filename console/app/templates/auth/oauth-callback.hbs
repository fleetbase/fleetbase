{{page-title (t "auth.login.oauth.signing-in")}}
<div class="flex flex-col items-center justify-center py-12 space-y-4">
    {{#if this.isExchanging}}
        <Spinner @loadingMessage={{t "auth.login.oauth.signing-in"}} @wrapperClass="flex flex-row items-center" @iconClass="mr-2" />
    {{else if this.error}}
        <InfoBlock @type="error" @icon="triangle-exclamation" @text={{this.error}} />
    {{/if}}
</div>
