<div class="fleetbase-github-card flex h-full min-h-0 w-full" ...attributes>
    <div class="flex h-full min-h-0 w-full flex-col overflow-hidden rounded-lg border border-gray-200 bg-gray-50 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="flex flex-shrink-0 flex-row items-center justify-between gap-3 border-b border-gray-200 px-4 py-2 dark:border-gray-700">
            <a href={{this.repositoryUrl}} target="_github" rel="noopener noreferrer" class="flex min-w-0 items-center gap-2 text-base font-bold text-black hover:text-blue-700 dark:text-gray-100 dark:hover:text-blue-300">
                <FaIcon @icon={{this.githubIcon}} class="flex-shrink-0 text-gray-700 dark:text-gray-200" />
                <span class="truncate">{{or this.data.full_name "fleetbase/fleetbase"}}</span>
            </a>
            <a href={{this.repositoryUrl}} target="_github" rel="noopener noreferrer" class="btn btn-xs btn-default flex-shrink-0">
                <FaIcon @icon="star" class="text-yellow-400" />
                <span class="ml-1.5">Star</span>
            </a>
        </div>

        {{#if this.getRepositoryData.isRunning}}
            <div class="flex flex-1 items-center justify-center">
                <Spinner />
            </div>
        {{else}}
            <div class="flex min-h-0 flex-1 flex-col justify-center gap-2 px-4 py-2">
                <p class="line-clamp-2 text-sm leading-5 text-gray-700 dark:text-gray-300">{{or this.data.description "Modular logistics and supply chain operating system."}}</p>
                <a
                    href={{this.releaseUrl}}
                    target="_github"
                    rel="noopener noreferrer"
                    class="inline-flex w-fit items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 font-mono text-xs font-semibold text-blue-700 hover:bg-blue-100 dark:border-blue-800 dark:bg-blue-900/40 dark:text-blue-300 dark:hover:bg-blue-900/70"
                >
                    <FaIcon @icon="tag" @size="xs" />
                    <span>Latest release {{this.latestRelease.name}}</span>
                </a>
            </div>

            <div class="grid flex-shrink-0 grid-cols-4 divide-x divide-gray-200 border-t border-gray-200 dark:divide-gray-700 dark:border-gray-700">
                {{#each this.stats as |stat|}}
                    <a href={{stat.url}} target="_github" rel="noopener noreferrer" class="flex min-w-0 items-center justify-center gap-1.5 px-2 py-2 text-xs text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700" title={{stat.title}}>
                        <FaIcon @icon={{stat.icon}} @size="xs" class="flex-shrink-0 text-gray-400" />
                        <span class="font-semibold text-gray-900 dark:text-gray-100">{{stat.value}}</span>
                        <span class="hidden truncate xl:inline">{{stat.label}}</span>
                    </a>
                {{/each}}
            </div>
        {{/if}}
    </div>
</div>
