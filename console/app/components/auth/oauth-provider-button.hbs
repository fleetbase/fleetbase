{{!-- The console's "Continue with <provider>" button, for the login and sign-up pages.

      Same arguments as ember-ui's <OauthProviderButton> (fleetbase/ember-ui#182, v0.4.3),
      which the Fleetbase Cloud sign-up step uses. Kept here until the console depends on
      ember-ui 0.4.3; then this file, auth/oauth-provider-logo and the .oauth-provider-*
      CSS in console.css go, and callers drop the `Auth::` prefix.

      @provider  { id, label, icon } as the API's provider list returns it
      @text      the button text; defaults to the provider's label
      @disabled
      @onClick   called with the provider --}}
<Button
    @wrapperClass="btn-block oauth-provider-button oauth-provider-{{@provider.id}}"
    @disabled={{@disabled}}
    @onClick={{fn this.onClick @provider}}
    data-test-oauth-provider={{@provider.id}}
    ...attributes
>
    {{!-- In Fleetbase's icon slot, so the logo sits at the far left like other buttons. --}}
    <span class="btn-icon-wrapper">
        <Auth::OauthProviderLogo @provider={{@provider.id}} @icon={{@provider.icon}} />
    </span>
    <span>{{or @text @provider.label}}</span>
</Button>
