{
    "name": "fleetbase/fleetbase",
    "type": "project",
    "description": "Modular logistics and supply chain operating system (LSOS)",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fleetbase Pte Ltd.",
            "email": "hello@fleetbase.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@fleetbase.io"
        }
    ],
    "require": {
        "php": ">=8.0 <8.3",
        "appstract/laravel-opcache": "^4.0",
        "fleetbase/core-api": "^1.6.74",
        "fleetbase/ai": "^0.0.5",
        "fleetbase/fleetops-api": "^0.6.75",
        "fleetbase/registry-bridge": "^0.1.11",
        "fleetbase/customer-portal-api": "^0.0.16",
        "fleetbase/storefront-api": "^0.4.31",
        "fleetbase/ledger-api": "^0.0.13",
        "fleetbase/valhalla-api": "^0.0.5",
        "fleetbase/vroom-api": "^0.0.5",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^10.0",
        "laravel/octane": "~2.22.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "maennchen/zipstream-php": "3.1.2",
        "phpoffice/phpspreadsheet": "^1.28",
        "predis/predis": "^2.1",
        "psr/http-factory-implementation": "*",
        "resend/resend-php": "^0.14.0",
        "s-ichikawa/laravel-sendgrid-driver": "^4.0",
        "stripe/stripe-php": "^17.0",
        "symfony/mailgun-mailer": "^7.1",
        "symfony/postmark-mailer": "^7.1"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://registry.fleetbase.io",
            "canonical": false,
            "exclude": [
                "fleetbase/core-api",
                "fleetbase/fleetops-api",
                "fleetbase/storefront-api",
                "fleetbase/ledger-api",
                "fleetbase/customer-portal-api",
                "fleetbase/ai",
                "fleetbase/valhalla-api",
                "fleetbase/vroom-api"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "clear-logs": [
            "rm -rf storage/logs/*.log",
            "composer dump-autoload",
            "chmod -R 777 storage",
            "chmod -R 777 bootstrap/cache",
            "chmod -R 777 resources"
        ],
        "clean-logs": [
            "composer run-script clear-logs"
        ],
        "test:unit": "phpunit --colors=always",
        "test:coverage:clover": "mkdir -p coverage && XDEBUG_MODE=coverage phpunit --coverage-clover=coverage/clover.xml --colors=always",
        "coverage:summary": "php scripts/coverage-summary.php coverage/clover.xml",
        "coverage:check": "php scripts/coverage-summary.php coverage/clover.xml --fail-under=100",
        "coverage:baseline": [
            "@test:coverage:clover",
            "@coverage:summary"
        ],
        "test": [
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "secure-http": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-b41t-wbzk-9q51": {
                        "reason": "TokenGuard bypass. Fixed on 10.x in v10.50.4, but Packagist still lists every 10.x version as affected. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-zwc5-qtrz-zm1n": {
                        "reason": "CRLF in the email rule, filed against illuminate/mail. No 10.x fix; symfony/mime rejects the payloads. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-mdq4-51ck-6kdq": {
                        "reason": "CRLF in the email rule (CVE-2026-48019). No 10.x fix; symfony/mime rejects the payloads. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-3r5d-mb8f-1qw9": {
                        "reason": "CRLF in the email rule. No 10.x fix; symfony/mime rejects the payloads. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-m5cs-t1y6-qpcs": {
                        "reason": "Temporary signed URL path confusion. No 10.x fix; local-driver temporary URLs are not used. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-d5tc-s1qs-h781": {
                        "reason": "Debug page XSS. No 10.x fix; needs APP_DEBUG=true. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    }
                }
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
